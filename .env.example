# Telegram Bot Token - @BotFather'dan alın
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Kontrol aralığı (dakika cinsinden, varsayılan: 5)
CHECK_INTERVAL_MINUTES=5

# Maksimum gezilecek sayfa sayısı (varsayılan: 5)
MAX_PAGES=5

# Sayfa başına ilan sayısı (varsayılan: 50)
PAGE_SIZE=50

# Veritabanı dosya yolu
DATABASE_PATH=data/ilantakip.db

# Log seviyesi (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
